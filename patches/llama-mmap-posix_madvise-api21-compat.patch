+// ETC fork: posix_madvise() and POSIX_MADV_* constants are Android API 23+;
+// madvise() and MADV_* are available at all API levels. On older Android
+// (minSdk 21) fall back — same advice values, only return-value convention
+// differs (we only check nonzero anyway).
+#if defined(__ANDROID__) && __ANDROID_API__ < 23
+#define posix_madvise(addr, len, advice) madvise(addr, len, advice)
+#ifndef POSIX_MADV_NORMAL
+#define POSIX_MADV_NORMAL     MADV_NORMAL
+#define POSIX_MADV_RANDOM     MADV_RANDOM
+#define POSIX_MADV_SEQUENTIAL MADV_SEQUENTIAL
+#define POSIX_MADV_WILLNEED   MADV_WILLNEED
+#define POSIX_MADV_DONTNEED   MADV_DONTNEED
+#endif
+#endif
