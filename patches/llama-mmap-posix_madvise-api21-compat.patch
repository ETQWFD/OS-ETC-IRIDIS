--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -64,8 +64,14 @@
 #ifdef _WIN32
 #    define llama_mmap_ftell _ftelli64
 #    define llama_mmap_fseek _fseeki64
+#elif defined(__ANDROID__)
+// ETC fork: ftello()/fseeko() are Android API 24+; on older devices (minSdk 21)
+// fall back to ftell()/fseek() — file positions here are metadata offsets, well
+// within 32-bit range even for multi-GB models.
+#    define llama_mmap_ftell ftell
+#    define llama_mmap_fseek fseek
 #else
 #    define llama_mmap_ftell ftello
 #    define llama_mmap_fseek fseeko
 #endif
