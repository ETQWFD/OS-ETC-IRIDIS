@@ -23,8 +23,14 @@
 #ifdef _WIN32
 #    define gguf_ftell _ftelli64
 #    define gguf_fseek _fseeki64
+#elif defined(__ANDROID__)
+// ETC fork: ftello()/fseeko() are Android API 24+; fall back to ftell()/fseek()
+// on minSdk 21. GGUF metadata offsets fit in 32-bit even for multi-GB models.
+#    define gguf_ftell ftell
+#    define gguf_fseek fseek
 #else
 #    define gguf_ftell ftello
 #    define gguf_fseek fseeko
 #endif
